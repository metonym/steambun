{
  "name": "steambun",
  "version": "0.1.0",
  "description": "Bun + Swift: a local web app in Bun becomes a real Mac app.",
  "author": "Eric Liu (https://github.com/metonym)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "steambun": "./src/cli.ts"
  },
  "exports": {
    "./config": "./src/config.ts",
    "./schema": "./src/schema.ts",
    "./bridge": "./src/bridge.ts",
    "./core": "./src/core/index.ts",
    "./ui": "./src/ui/index.ts",
    "./tools": "./src/tools.ts",
    "./test": "./src/test.ts",
    "./svelte": "./src/svelte.ts",
    "./native.css": "./src/ui/native.css",
    "./tsconfig.json": "./src/tsconfig.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test ./tests",
    "test:e2e": "bun run --filter '*' test",
    "test:changed": "bivium run --suite unit",
    "test:package": "bun scripts/test-package.ts",
    "bench": "ostia bench",
    "bench:quick": "ostia bench bench/tools.bench.ts bench/core.bench.ts",
    "bench:ci": "ostia ci",
    "bench:memory": "bun bench/memory.ts",
    "typecheck": "bun check",
    "knip": "knip-bun",
    "fmt": "bun fmt",
    "lint": "bun fmt --check && bun lint --no-script --max-warnings 0"
  },
  "workspaces": [
    "examples/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bivium": "^0.4.0",
    "knip": "^6.44.2",
    "ostia": "^0.2.12",
    "svelte": "^5.57.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metonym/steambun.git"
  },
  "homepage": "https://github.com/metonym/steambun",
  "bugs": "https://github.com/metonym/steambun/issues",
  "keywords": [
    "bun",
    "swift",
    "macos",
    "desktop",
    "webkit",
    "appkit"
  ]
}
