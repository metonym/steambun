{
  "name": "steambun",
  "version": "0.1.0",
  "description": "A Bun-native, Vite-class dev & bundle toolkit",
  "type": "module",
  "license": "MIT",
  "bin": {
    "steambun": "./bin/steambun.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./client": {
      "types": "./src/client.d.ts"
    }
  },
  "files": [
    "src",
    "bin"
  ],
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write . --unsafe",
    "knip": "knip-bun",
    "build:package": "bun scripts/build-package.ts",
    "bench": "ostia bench bench/*.bench.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.4.1",
    "knip": "^6.34.0",
    "ostia": "^0.1.5",
    "typescript": "^7.0.2"
  }
}
