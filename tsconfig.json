{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["@types/bun"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "incremental": true
  },
  "exclude": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.steambun/serve.ts",
    "**/.steambun/prod-serve.ts",
    "**/.steambun/dist-serve.ts",
    "**/.steambun/alias-plugin.ts",
    "**/.steambun/server-boundary-plugin.ts",
    "**/.steambun/vite-suffix-plugin.ts",
    "**/.steambun/plugin-*.ts"
  ]
}
