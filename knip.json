{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/devpage.ts",
        "scripts/*.ts",
        "bivium.config.ts",
        "ostia.config.ts",
        "bench/*.ts"
      ],
      "project": ["src/**/*.ts", "tests/*.ts", "scripts/*.ts", "bench/*.ts"],
      "ignoreBinaries": ["brew", "swiftc", "vmmap"]
    },
    "examples/core": {
      "entry": ["main.tsx", "core.ts", "test/*.e2e.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "examples/hello": {
      "entry": ["main.ts", "test/*.e2e.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "examples/load-bar": {
      "entry": ["main.ts", "core.ts", "test/*.e2e.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "examples/native-op": {
      "entry": ["main.ts", "native/bridge.ts", "test/*.e2e.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "examples/todo-bar": {
      "entry": ["main.ts", "test/*.e2e.ts"],
      "project": ["**/*.{ts,tsx}"]
    }
  }
}
